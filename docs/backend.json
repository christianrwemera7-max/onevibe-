
{
  "entities": {
    "Registration": {
      "title": "Festival Registration",
      "description": "Données d'inscription pour les pass et les exposants",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID de l'utilisateur Firebase" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["PASS", "EXPOSITOR"] },
        "passCategory": { "type": "string", "enum": ["STANDARD", "VIP", null] },
        "company": { "type": "string", "description": "Nom de la marque pour les exposants" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ticketCode": { "type": "string", "description": "Code unique généré pour le billet" }
      },
      "required": ["userId", "name", "email", "type", "createdAt"]
    },
    "Talent": {
      "title": "Festival Talent",
      "description": "Artistes, créateurs et entrepreneurs participants",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["MUSIC", "CREATIVE", "BUSINESS", "DIGITAL"] },
        "role": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "role", "imageUrl"]
    },
    "ProgramItem": {
      "title": "Program Item",
      "description": "Élément de la programmation horaire du festival",
      "type": "object",
      "properties": {
        "time": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["time", "title", "desc", "imageUrl"]
    },
    "FestivalSettings": {
      "title": "Festival Settings",
      "description": "Configurations globales de l'événement",
      "type": "object",
      "properties": {
        "eventName": { "type": "string", "description": "Nom officiel de l'événement" },
        "eventTagline": { "type": "string", "description": "Slogan ou description courte" },
        "eventDate": { "type": "string", "description": "Date de l'événement (format ISO: YYYY-MM-DDTHH:MM:SS)" },
        "eventLocation": { "type": "string", "description": "Lieu de l'événement" },
        "heroImageUrl": { "type": "string" },
        "heroImageUrl2": { "type": "string" },
        "heroImageUrl3": { "type": "string" },
        "ticketingUrl": { "type": "string" },
        "teaserUrl": { "type": "string" },
        "isCarouselEnabled": { "type": "boolean" },
        "musicDesc": { "type": "string" },
        "musicImg": { "type": "string" },
        "creativeDesc": { "type": "string" },
        "creativeImg": { "type": "string" },
        "digitalDesc": { "type": "string" },
        "digitalImg": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "twitterUrl": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "tiktokUrl": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Inscriptions des participants, achats de pass et codes uniques"
    },
    "/talents/{talentId}": {
      "schema": "Talent",
      "description": "Liste dynamique des talents affichés sur le site"
    },
    "/program/{programId}": {
      "schema": "ProgramItem",
      "description": "Liste dynamique de la programmation chronologique"
    },
    "/settings/festival": {
      "schema": "FestivalSettings",
      "description": "Paramètres généraux modifiables de l'événement"
    }
  }
}
