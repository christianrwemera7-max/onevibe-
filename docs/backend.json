
{
  "entities": {
    "Registration": {
      "title": "Festival Registration",
      "description": "Données d'inscription pour les pass et les exposants",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID de l'utilisateur Firebase" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["PASS", "EXPOSITOR"] },
        "passCategory": { "type": "string", "enum": ["STANDARD", "VIP", null] },
        "company": { "type": "string", "description": "Nom de la marque pour les exposants" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ticketCode": { "type": "string", "description": "Code unique généré pour le billet" }
      },
      "required": ["userId", "name", "email", "type", "createdAt"]
    },
    "Talent": {
      "title": "Festival Talent",
      "description": "Artistes, créateurs et entrepreneurs participants",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["MUSIC", "CREATIVE", "BUSINESS", "DIGITAL"] },
        "role": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "role", "imageUrl"]
    },
    "Universe": {
      "title": "Festival Universe",
      "description": "Une dimension thématique du festival (Musique, Digital, etc.)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "iconName": { "type": "string", "description": "Nom de l'icône Lucide" },
        "color": { "type": "string", "enum": ["primary", "secondary", "accent"] },
        "order": { "type": "number" }
      },
      "required": ["title", "description", "imageUrl"]
    },
    "ProgramItem": {
      "title": "Program Item",
      "description": "Élément de la programmation horaire du festival",
      "type": "object",
      "properties": {
        "time": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["time", "title", "desc", "imageUrl"]
    },
    "MerchItem": {
      "title": "Merch Item",
      "description": "Article de la boutique officielle",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string", "description": "Lien optionnel vers WhatsApp ou paiement" }
      },
      "required": ["name", "price", "imageUrl"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "Image pour la galerie Vibe Moments",
      "type": "object",
      "properties": {
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "createdAt"]
    },
    "Sponsor": {
      "title": "Festival Sponsor",
      "description": "Partenaire officiel du festival",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "tier": { "type": "string", "enum": ["DIAMOND", "GOLD", "PARTNER"] }
      },
      "required": ["name", "logoUrl"]
    },
    "FestivalSettings": {
      "title": "Festival Settings",
      "description": "Configurations globales de l'événement",
      "type": "object",
      "properties": {
        "eventName": { "type": "string" },
        "eventTagline": { "type": "string" },
        "logoUrl": { "type": "string" },
        "eventDate": { "type": "string" },
        "eventLocation": { "type": "string" },
        "heroGifUrl": { "type": "string" },
        "loadingGifUrl": { "type": "string" },
        "spotVideoUrl": { "type": "string" },
        "globalBgUrl": { "type": "string" },
        "exposantsImg": { "type": "string" },
        "ticketingUrl": { "type": "string" },
        "teaserUrl": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "twitterUrl": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "tiktokUrl": { "type": "string" }
      }
    },
    "Analytics": {
      "title": "Website Analytics",
      "description": "Statistiques de fréquentation",
      "type": "object",
      "properties": {
        "visitorCount": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Inscriptions"
    },
    "/talents/{talentId}": {
      "schema": "Talent",
      "description": "Line-up"
    },
    "/universes/{universeId}": {
      "schema": "Universe",
      "description": "Univers thématiques"
    },
    "/program/{programId}": {
      "schema": "ProgramItem",
      "description": "Programmation"
    },
    "/merch/{merchId}": {
      "schema": "MerchItem",
      "description": "Boutique"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Galerie d'images"
    },
    "/sponsors/{sponsorId}": {
      "schema": "Sponsor",
      "description": "Liste des sponsors affichés sur le site"
    },
    "/settings/festival": {
      "schema": "FestivalSettings",
      "description": "Paramètres"
    },
    "/analytics/global": {
      "schema": "Analytics",
      "description": "Stats"
    }
  }
}
