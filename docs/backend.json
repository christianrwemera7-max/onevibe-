{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Stores user profile information and credit balance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "university": { "type": "string" },
        "faculty": { "type": "string" },
        "promotion": { "type": "string" },
        "credits": { "type": "number", "description": "Current credit balance in FC" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "credits", "role"]
    },
    "document": {
      "title": "Generated Document",
      "description": "Stores metadata and payment status for generated PDFs.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "course": { "type": "string" },
        "professor": { "type": "string" },
        "content": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "font": { "type": "string" },
            "fontSize": { "type": "number" },
            "lineHeight": { "type": "string" },
            "margins": { "type": "string" }
          }
        },
        "serviceType": { "type": "string", "enum": ["simple", "nb", "color"] },
        "hasCoverPage": { "type": "boolean" },
        "hasBinding": { "type": "boolean" },
        "pageCount": { "type": "number" },
        "price": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "course", "professor", "content", "serviceType", "hasCoverPage", "hasBinding", "pageCount", "price", "isPaid", "createdAt"]
    },
    "transaction": {
      "title": "Credit Transaction",
      "description": "History of credit recharges or document payments.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["recharge", "payment"] },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile and balance"
    },
    "/documents/{docId}": {
      "schema": "document",
      "description": "Metadata for generated documents"
    },
    "/transactions/{transId}": {
      "schema": "transaction",
      "description": "History of credit changes"
    }
  }
}